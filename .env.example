# ---- Server-side only (never exposed to the browser) ----
# OpenAI / ChatGPT API Configuration
OPENAI_API_KEY=your_openai_key_here
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_SIZE=1024x1792

# Optional Fallback: Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_ASPECT_RATIO=9:16

# Rate limit per client IP (best-effort, in-memory per server instance)
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=60

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET=ai-booth
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ---- Client-side (VITE_ prefix = public, contains no secrets) ----
# Default mode when no ?mode= URL param is given: test | ai
VITE_DEFAULT_MODE=ai
